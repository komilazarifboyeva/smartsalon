<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Mavjud fayllar va papkalarga teginma
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qolgan barcha so'rovlarni index.html'ga yo'naltir (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Static asset'lar uzoq cache
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML'ni cache qilmaslik
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
